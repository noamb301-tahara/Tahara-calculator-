{
  "name": "shorts-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rebuilds screen-recorded tutorial Shorts as Hebrew tutorials: analysis, reconstructed demo UI, Hebrew voice, subtitles, guide and SEO.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @studio/admin typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "tsx scripts/studio.ts",
    "demo:render": "tsx scripts/render-demo.ts",
    "demo:source": "tsx scripts/make-source-demo.ts",
    "e2e": "tsx scripts/studio.ts run input/short-demo.mp4 --auto-approve",
    "batch": "tsx scripts/studio.ts batch input",
    "remotion:studio": "pnpm --filter @studio/renderer studio",
    "admin:dev": "pnpm --filter @studio/admin dev",
    "admin:build": "pnpm --filter @studio/admin build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "@studio/shared": "workspace:*",
    "@studio/script-writer": "workspace:*",
    "@studio/subtitles": "workspace:*",
    "@studio/remotion-scenes": "workspace:*",
    "@studio/renderer": "workspace:*"
  }
}
