# Copy to .env and fill in. Never commit real keys.
# Hebrew TTS (voice.provider = "elevenlabs")
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Claude (vision + tutorial extraction + Hebrew script writing, llm.provider = "anthropic")
ANTHROPIC_API_KEY=
# Optional overrides
STUDIO_CONFIG=config/studio.config.json
STUDIO_DATA_DIR=data
STUDIO_OUTPUT_DIR=output
# Chromium used by Remotion / Playwright if the bundled download is unavailable
STUDIO_BROWSER_EXECUTABLE=
